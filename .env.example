# Erika 环境变量示例 —— 复制成 .env 后填写（.env 已在 .gitignore 中，不会入库）
#
# GitHub Token：生产必须配置。未认证配额只有 60 次/小时（按 IP），
# 认证后 5000 次/小时，且带认证的 ETag 条件请求返回 304 时不计入主配额。
# 权限只需要读公开仓库：classic PAT 勾 public_repo 即可，或用细粒度 token 的
# "Public Repositories (read-only)"。
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 兼容 gh CLI 的变量名，二者取其一即可
# GH_TOKEN=

# API 监听端口（默认 8787）
# PORT=8787

# 以下为可选覆盖，通常不用改
# ERIKA_TEMPLATES_DIR=packages/templates
# ERIKA_PRESETS_PATH=apps/api/presets/presets.json
# ERIKA_FONTS_DIR=packages/templates/fonts
# ERIKA_RENDER_CACHE_MB=512
# 缓存时间表（毫秒）：数据新鲜度 / 最大陈旧 / 仓库不存在负缓存 / 暂时性失败退避
# ERIKA_FRESH_TTL_MS=1800000
# ERIKA_MAX_STALE_MS=172800000
# ERIKA_NOT_FOUND_TTL_MS=3600000
# ERIKA_TRANSIENT_TTL_MS=60000
